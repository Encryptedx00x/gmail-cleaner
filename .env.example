# === OBRIGATÓRIAS ===
OPENAI_API_KEY=sk-...
GMAIL_CREDENTIALS_PATH=./credentials/credentials.json
GMAIL_TOKEN_PATH=./credentials/token.json

# === BANCO DE DADOS ===
DB_PATH=./data/cache.db

# === COMPORTAMENTO ===
LOG_LEVEL=INFO
SAFE_MODE=true              # se true, nunca deleta sem confirmação explícita
MAX_BATCH_SIZE=30           # emails por chamada Claude
CONFIDENCE_THRESHOLD=0.80   # mínimo para ação automática
MAX_RETRIES=3               # tentativas em caso de erro de API
RATE_LIMIT_DELAY=0.1        # segundos entre chamadas Gmail API
